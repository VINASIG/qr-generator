---
import { ChevronDown } from '@lucide/astro';
import FieldError from './FieldError.astro';
interface Props {
  id: string;
  label: string;
  valueLabel: string;
  describedby?: string;
  timeFor?: string;
}
const { id, label, valueLabel, describedby, timeFor } = Astro.props;
const descriptions = [
  id + '-error',
  ...(describedby ?? '')
    .split(/\s+/u)
    .filter((value) => value && value !== 'form-status'),
].join(' ');
---

<select
  id={id}
  hidden
  data-custom-select
  data-time-for={timeFor}
  aria-describedby={descriptions}
>
  <slot />
</select>
<button
  id={id + '-control'}
  class="select-control"
  type="button"
  role="combobox"
  aria-label={label}
  aria-haspopup="listbox"
  aria-expanded="false"
  aria-controls={id + '-options'}
  aria-describedby={descriptions}
  disabled
>
  <span data-control-value>{valueLabel}</span>
  <ChevronDown size={20} aria-hidden="true" data-control-indicator />
</button>
<div id={id + '-options'} class="select-options" hidden></div>
<FieldError id={id} />
