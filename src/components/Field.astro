---
import DateInput from './DateInput.astro';
import SelectControl from './SelectControl.astro';
import FieldError from './FieldError.astro';
interface Props {
  id: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'url' | 'date' | 'time';
  rows?: number;
  placeholder?: string;
  help?: string;
  helpIds?: string;
  required?: boolean;
  inputmode?: 'text' | 'decimal';
}
const {
  id,
  label,
  type = 'text',
  rows,
  placeholder,
  help,
  helpIds,
  required = false,
  inputmode = 'text',
} = Astro.props;
const describedby =
  id +
  '-error' +
  (help ? ' ' + id + '-help' : '') +
  (helpIds ? ' ' + helpIds : '');
---

<div class="field">
  <label for={id}>{label}</label>
  {rows ? (
    <textarea
      id={id}
      rows={rows}
      placeholder={placeholder}
      required={required}
      spellcheck="false"
      autocomplete="off"
      aria-describedby={describedby}
    ></textarea>
  ) : type === 'date' ? (
    <DateInput
      id={id}
      label={label}
      describedby={describedby}
      required={required}
    />
  ) : type === 'time' ? (
    <>
      <div class="time-input-row">
        <input
          id={id}
          type="text"
          placeholder="Hours:minutes"
          required={required}
          autocomplete="off"
          spellcheck="false"
          aria-describedby={describedby}
          maxlength="5"
          data-time-input
        />
        <div>
          <label class="visually-hidden" for={id + '-preset-control'}>
            {label + ' choices'}
          </label>
          <SelectControl
            id={id + '-preset'}
            label={label + ' choices'}
            valueLabel="Choose time"
            timeFor={id}
          >
            <option value="">Choose time</option>
            {Array.from({ length: 96 }, (_, index) => {
              const time =
                String(Math.floor(index / 4)).padStart(2, '0') +
                ':' +
                String((index % 4) * 15).padStart(2, '0');
              return <option value={time}>{time}</option>;
            })}
          </SelectControl>
        </div>
      </div>
    </>
  ) : (
    <input
      id={id}
      type={type}
      placeholder={placeholder}
      required={required}
      inputmode={inputmode === 'decimal' ? 'decimal' : undefined}
      spellcheck="false"
      autocomplete="off"
      aria-describedby={describedby}
    />
  )}
  {type !== 'date' && <FieldError id={id} />}
  {type === 'time' && (
    <p class="supporting">
      Enter hours and minutes, for example 09:30. You can enter any minute.
    </p>
  )}
  {help && (
    <p id={id + '-help'} class="supporting">
      {help}
    </p>
  )}
</div>
